# resolver_preload.conf — SHAPE ONLY (example). The real file is generated by
#   nsc generate config --mem-resolver
# from the nsc-minted operator (PMOVES) + SYS/CORE/EDGE/CLOUD accounts, and
# injected by PMOVES.AI secrets-funnel at deploy time. The account JWTs are
# PUBLIC (non-secret) but change on account edit, so they are funnel-rendered,
# never hand-committed. The real resolver_preload.conf is gitignored.
#
# system_account is the SYS account's public key. resolver: MEMORY is the
# doc-recommended choice for a small, rarely-changing set of accounts (our four
# fixed trust zones).

system_account: AA__SYS_ACCOUNT_PUBKEY__EXAMPLE__

resolver: MEMORY

resolver_preload: {
  // SYS  — system account: $SYS.* events, monitoring guard
  AA__SYS_ACCOUNT_PUBKEY__EXAMPLE__: "eyJ0eXAiOiJKV1QiLCJhbGciOi__SYS_ACCOUNT_JWT__"
  // CORE — all hub services (agents, geometry/chit, media, tokenism, mesh, archon, evo, a2ui)
  AA__CORE_ACCOUNT_PUBKEY__EXAMPLE__: "eyJ0eXAiOiJKV1QiLCJhbGciOi__CORE_ACCOUNT_JWT__"
  // EDGE — jetson/edge leaves (sees only what CORE exports)
  AA__EDGE_ACCOUNT_PUBKEY__EXAMPLE__: "eyJ0eXAiOiJKV1QiLCJhbGciOi__EDGE_ACCOUNT_JWT__"
  // CLOUD — Hostinger VPS/KVM leaves (egress/exit-node lane)
  AC__CLOUD_ACCOUNT_PUBKEY__EXAMPLE__: "eyJ0eXAiOiJKV1QiLCJhbGciOi__CLOUD_ACCOUNT_JWT__"
}
